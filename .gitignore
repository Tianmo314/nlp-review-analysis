# 数据与模型权重不入库：按 README 下载或自行放到这两个目录
data/*
!data/.gitkeep
models/*
!models/.gitkeep

# 例外：作业用的短评语料随 PR 提交，便于复现（字段只有 text/score/time/cid，不含账号信息）
!data/douban/
data/douban/*
!data/douban/痴迷.jsonl
!data/douban/痴迷_raw.jsonl

# 豆瓣登录态含 cookie，绝不入库（写在最后，优先级最高）
data/douban/.storage_state.json

# 训练产物
artifacts/*
# 例外：测试集逐条预测随 PR 提交，便于核对指标（embedding、model 等二进制仍不入库）
!artifacts/douban/
artifacts/douban/*
!artifacts/douban/test_predictions.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 系统与工具
.DS_Store
.idea/
.workbuddy/
*.log
